# Ghostty Terminal Configuration

theme = dark:iTerm2 Tango Dark,light:iTerm2 Tango Light

background = 000000
foreground = ffffff
background-opacity = 0.85

font-family = "Noto Mono for Powerline"
font-size = 12

font-thicken = true
font-thicken-strength = 128

cursor-style = bar
cursor-style-blink = true

copy-on-select = true
clipboard-paste-protection = true

window-width = 90
window-height = 30

macos-option-as-alt = true

macos-titlebar-style = transparent
macos-icon = custom
macos-custom-icon = ~/.config/ghostty/dark.icns

