# Ghostty Terminal Configuration

theme = dark:iTerm2 Tango Dark,light:iTerm2 Tango Light

background = 000000
foreground = ffffff
background-opacity = 0.85

font-family = "Noto Mono for Powerline"
font-size = 12

font-thicken = true
font-thicken-strength = 128

cursor-style = bar
cursor-style-blink = true

window-width = 90
window-height = 30

macos-titlebar-style = transparent
